{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qilab/config.schema.json",
  "title": "QILab Node Configuration",
  "description": "Machine-readable mirror of the qilab config format documented in config_guide.md. Source of truth for the qilab_web_control structured editor. If you change the config format, update this file in the same change.",
  "x-qilab-schema-version": "dev",
  "type": "object",
  "required": ["nodes"],
  "additionalProperties": false,
  "properties": {
    "entanglement_links": {
      "title": "Entanglement links",
      "description": "Optional. One entry per physical link between two configured nodes. node_a/node_b must match names under 'nodes'.",
      "type": "array",
      "items": { "$ref": "#/$defs/entanglement_link" }
    },
    "system": {
      "title": "QiLab System Configuration",
      "description": "Optional. Global runtime parameters; defaults apply if omitted.",
      "$ref": "#/$defs/system"
    },
    "nodes": {
      "title": "Nodes",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "title": "Node",
      "type": "object",
      "required": ["qubit_arrays"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "description": "Human-readable label for the node.",
          "type": "string"
        },
        "node_type": {
          "title": "Node type",
          "description": "Hardware type.",
          "type": "string",
          "enum": ["GENERIC", "NV_CENTER", "ION_TRAP", "PROCESSOR"],
          "default": "GENERIC"
        },
        "quantum_operations_delay_ns": {
          "title": "Operation delays (ns)",
          "description": "Optional per-operation delays in nanoseconds.",
          "$ref": "#/$defs/operation_delays"
        },
        "qubit_arrays": {
          "title": "Qubit arrays",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/qubit_array" }
        }
      }
    },
    "operation_delays": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "single_gate_rotation": { "type": "integer", "minimum": 0, "unit": "ns" },
        "two_qubit_gate_rotation": { "type": "integer", "minimum": 0, "unit": "ns" },
        "measurement": { "type": "integer", "minimum": 0, "unit": "ns" },
        "entanglement": { "type": "integer", "minimum": 0, "unit": "ns" },
        "qubit_move": { "type": "integer", "minimum": 0, "unit": "ns" },
        "qubit_swap": { "type": "integer", "minimum": 0, "unit": "ns" },
        "qubit_init": { "type": "integer", "minimum": 0, "unit": "ns" }
      }
    },
    "qubit_array": {
      "title": "Qubit array",
      "type": "object",
      "required": ["num_qubits", "noise_model"],
      "additionalProperties": false,
      "properties": {
        "num_qubits": {
          "title": "Number of qubits",
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "noise_model": { "$ref": "#/$defs/qubit_noise_model" }
      }
    },
    "qubit_noise_model": {
      "title": "Qubit noise model",
      "type": "object",
      "oneOf": [
        {
          "title": "BASIC",
          "additionalProperties": false,
          "required": ["type", "t2_value"],
          "properties": {
            "type": { "const": "BASIC" },
            "t2_value": { "type": "number", "minimum": 0, "unit": "ns" }
          }
        },
        {
          "title": "ADVANCED",
          "additionalProperties": false,
          "required": ["type", "t1_value", "t2_value", "gate_error_rate"],
          "properties": {
            "type": { "const": "ADVANCED" },
            "t1_value": { "type": "number", "minimum": 0, "unit": "ns" },
            "t2_value": { "type": "number", "minimum": 0, "unit": "ns" },
            "gate_error_rate": { "type": "number", "minimum": 0 }
          }
        },
        {
          "title": "PHASE_FLIP",
          "additionalProperties": false,
          "required": ["type", "t2_value"],
          "properties": {
            "type": { "const": "PHASE_FLIP" },
            "t2_value": { "type": "number", "minimum": 0, "unit": "ns" }
          }
        }
      ]
    },
    "system": {
      "title": "QiLab System Configuration",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transmission_cycle_time_us": {
          "title": "Transmission cycle time",
          "description": "Period of the transmission runner's busy-spin cycle. Defaults to 5 if omitted.",
          "type": "number",
          "minimum": 0,
          "unit": "us",
          "default": 5
        },
        "qubit_noise_enabled": {
          "title": "Qubit noise enabled",
          "description": "Enables applying qubit-in-memory noise during simulation. Defaults to true if omitted.",
          "type": "boolean",
          "default": true
        },
        "entanglement_noise_enabled": {
          "title": "Entanglement noise enabled",
          "description": "Enables applying entanglement-channel noise during simulation. Defaults to true if omitted.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "entanglement_link": {
      "title": "Entanglement link",
      "type": "object",
      "required": ["node_a", "node_b", "attempt_model", "channel_model"],
      "additionalProperties": false,
      "properties": {
        "node_a": {
          "title": "Node A",
          "description": "Name of the first node of the link. Must match a configured node's name.",
          "type": "string"
        },
        "node_b": {
          "title": "Node B",
          "description": "Name of the second node of the link. Must match a configured node's name.",
          "type": "string"
        },
        "attempt_model": {
          "title": "Entanglement attempt model",
          "description": "Batching/delay/success-probability model consumed by the entanglement manager.",
          "$ref": "#/$defs/entanglement_attempt_model"
        },
        "channel_model": {
          "title": "Entanglement channel model",
          "description": "Pauli-noise channel model applied by the simulator manager on successful entanglement.",
          "$ref": "#/$defs/entanglement_channel_model"
        }
      }
    },
    "entanglement_attempt_model": {
      "title": "Entanglement attempt model",
      "type": "object",
      "oneOf": [
        {
          "title": "BASIC",
          "additionalProperties": false,
          "required": ["type", "attempt_duration_ns", "batch_size", "p_success", "rng_seed"],
          "properties": {
            "type": { "const": "BASIC" },
            "attempt_duration_ns": { "type": "integer", "minimum": 1, "unit": "ns" },
            "batch_size": { "type": "integer", "minimum": 1 },
            "p_success": { "type": "number", "minimum": 0, "maximum": 1 },
            "rng_seed": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "entanglement_channel_model": {
      "title": "Entanglement channel model",
      "type": "object",
      "oneOf": [
        {
          "title": "BASIC",
          "additionalProperties": false,
          "required": ["type", "p_depolarizing", "p_dephasing"],
          "properties": {
            "type": { "const": "BASIC" },
            "p_depolarizing": { "type": "number", "minimum": 0, "maximum": 1 },
            "p_dephasing": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      ]
    }
  }
}
