        <mxCell id="0hlTdycuqXmVdKRhDdZF-3" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Threading Runner&lt;/h1&gt;&lt;div&gt;The SimulatorRunner is one single thread with single simulator running and queing the commands.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
